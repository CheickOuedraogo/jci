---
import { FORM_ACCESS_KEY, SITE } from "../lib/site.config";
import { COPY } from "../data/content";

const { lang = "fr" } = Astro.props;
const t = COPY[lang].join;
const enabled = FORM_ACCESS_KEY !== "PLEASE_SET_YOUR_WEB3FORMS_ACCESS_KEY";
---

<section class="form-section">
  <div class="card">
    <h3>{t.formTitle}</h3>
    <p>{t.formIntro}</p>

    {!enabled && <p class="form-notice">{t.formNotice}</p>}

    <form
      class="membership-form"
      data-membership-form
      action="https://api.web3forms.com/submit"
      method="POST"
      data-sending={t.sending}
      data-success={t.success}
      data-error={t.error}
      data-error-quota={t.errorQuota}
      data-error-network={t.errorNetwork}
      data-whatsapp={SITE.whatsapp}
      data-whatsapp-label={t.whatsappFallback}
    >
      <input
        type="hidden"
        name="access_key"
        value={FORM_ACCESS_KEY}
      />
      <input type="hidden" name="subject" value="Nouvelle candidature — JCI Yennèga Amazones Émergentes" />
      <input type="hidden" name="from_name" value="Site des Amazones Émergentes" />
      <input
        type="checkbox"
        name="botcheck"
        style="display: none;"
        tabindex="-1"
        aria-hidden="true"
        autocomplete="off"
      />
      <input type="hidden" name="website" value="" autocomplete="off" />

      <div class="form-grid">
        <div class="field">
          <label for="last_name">{t.fields.lastName} *</label>
          <input id="last_name" name="Nom" type="text" required />
        </div>
        <div class="field">
          <label for="first_name">{t.fields.firstName} *</label>
          <input id="first_name" name="Prénom" type="text" required />
        </div>
        <div class="field">
          <label for="phone">{t.fields.phone} *</label>
          <input id="phone" name="Téléphone" type="tel" inputmode="tel" required />
        </div>
        <div class="field">
          <label for="dob">{t.fields.dob} *</label>
          <input id="dob" name="Date de naissance" type="date" required />
        </div>
        <div class="field">
          <label for="email">{t.fields.email} *</label>
          <input id="email" name="Email" type="email" inputmode="email" required />
        </div>
        <div class="field">
          <label for="occupation">{t.fields.occupation} *</label>
          <input id="occupation" name="Occupation" type="text" required />
        </div>
      </div>

      <div class="field">
        <label for="motivation">{t.fields.motivation} *</label>
        <textarea id="motivation" name="Motivation" required></textarea>
      </div>

      <label class="consent">
        <input type="checkbox" name="consent" required />
        <span>{t.fields.consent}</span>
      </label>

      <button
        class="btn btn--primary btn--lg"
        type="submit"
        data-submit
        disabled={!enabled}
      >
        {t.submit}
      </button>

      <p class="form-status" data-form-status role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style>
  .form-section {
    max-width: 48rem;
  }

  .form-section .card {
    padding: clamp(1.4rem, 4vw, 2.6rem);
  }

  .form-grid {
    display: grid;
    gap: 0 1.2rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .form-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  button[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }
</style>

<script>
  /* Web3Forms repond 200 + {success:false} sur un quota epuise, et 429/402
     selon la situation. Sans distinguer ces cas, la seule sortie etait un
     texte d'erreur mort, que la visiteuse ne pouvait pas cliquer. */
  const QUOTA_RE = /(limit|quota|exceed|exhaust|too many|capacity|satur)/i;
  const TIMEOUT_MS = 20000;

  const forms = document.querySelectorAll<HTMLFormElement>("[data-membership-form]");

  forms.forEach((form) => {
    const status = form.querySelector<HTMLElement>("[data-form-status]");
    const submitBtn = form.querySelector<HTMLButtonElement>("[data-submit]");
    if (!status || !submitBtn) return;

    const d = form.dataset;

    const render = (state: string, text: string, offerWhatsApp: boolean) => {
      status.dataset.state = state;
      status.textContent = text;
      if (!offerWhatsApp) return;
      const link = document.createElement("a");
      link.className = "form-status__link";
      link.href = d.whatsapp ?? "";
      link.target = "_blank";
      link.rel = "noopener";
      link.textContent = d.whatsappLabel ?? "";
      status.append(" ", link);
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const bot = form.querySelector<HTMLInputElement>('input[name="botcheck"]');
      if (bot?.checked) return;
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      // cle Web3Forms non configuree : le bouton est desactive a la
      // construction, mais requestSubmit() contourne l'attribut disabled
      if (submitBtn.disabled) return;

      // requestSubmit() ignore un bouton desactive : sans cette memorisation,
      // le finally reactiverait definitivement le bouton d'une candidature
      const wasDisabled = submitBtn.disabled;
      const originalLabel = submitBtn.textContent ?? "";
      submitBtn.disabled = true;
      submitBtn.textContent = d.sending ?? "";
      render("sending", "", false);

      // sans AbortController, un reseau fige laisse le bouton desactive indefiniment
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), TIMEOUT_MS);

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
          signal: controller.signal,
        });

        // la reponse peut etre du HTML (page d'erreur de l'hebergeur) : on
        // n'indexe pas sur un json sans garde, sinon le vrai motif est perdu
        const payload = await response.json().catch(() => null);
        const message = typeof payload?.message === "string" ? payload.message : "";

        if (response.status === 429 || QUOTA_RE.test(message)) {
          render("quota", d.errorQuota ?? d.error ?? "", true);
          return;
        }
        if (!response.ok) {
          render("error", d.error ?? "", true);
          return;
        }
        if (!payload?.success) {
          render(QUOTA_RE.test(message) ? "quota" : "error",
                 QUOTA_RE.test(message) ? d.errorQuota ?? d.error ?? "" : d.error ?? "", true);
          return;
        }

        status.dataset.state = "success";
        status.textContent = d.success ?? "";
        form.reset();
      } catch {
        render("network", d.errorNetwork ?? d.error ?? "", true);
      } finally {
        clearTimeout(timer);
        submitBtn.disabled = wasDisabled;
        submitBtn.textContent = originalLabel;
      }
    });
  });
</script>