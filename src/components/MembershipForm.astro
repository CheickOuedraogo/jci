---
import { FORM_ACCESS_KEY } from "../lib/site.config";
import { COPY } from "../data/content";

const { lang = "fr" } = Astro.props;
const t = COPY[lang].join;
const enabled = FORM_ACCESS_KEY !== "PLEASE_SET_YOUR_WEB3FORMS_ACCESS_KEY";
---

<section class="form-section">
  <div class="card">
    <h3>{t.formTitle}</h3>
    <p>{t.formIntro}</p>

    {!enabled && <p class="form-notice">{t.formNotice}</p>}

    <form
      class="membership-form"
      data-membership-form
      action="https://api.web3forms.com/submit"
      method="POST"
      data-sending={t.sending}
      data-success={t.success}
      data-error={t.error}
    >
      <input
        type="hidden"
        name="access_key"
        value={FORM_ACCESS_KEY}
      />
      <input type="hidden" name="subject" value="Nouvelle candidature — JCI Yennèga Amazones Émergentes" />
      <input type="hidden" name="from_name" value="Site des Amazones Émergentes" />
      <input
        type="checkbox"
        name="botcheck"
        style="display: none;"
        tabindex="-1"
        aria-hidden="true"
        autocomplete="off"
      />
      <input type="hidden" name="website" value="" autocomplete="off" />

      <div class="form-grid">
        <div class="field">
          <label for="last_name">{t.fields.lastName} *</label>
          <input id="last_name" name="Nom" type="text" required />
        </div>
        <div class="field">
          <label for="first_name">{t.fields.firstName} *</label>
          <input id="first_name" name="Prénom" type="text" required />
        </div>
        <div class="field">
          <label for="phone">{t.fields.phone} *</label>
          <input id="phone" name="Téléphone" type="tel" inputmode="tel" required />
        </div>
        <div class="field">
          <label for="dob">{t.fields.dob} *</label>
          <input id="dob" name="Date de naissance" type="date" required />
        </div>
        <div class="field">
          <label for="email">{t.fields.email} *</label>
          <input id="email" name="Email" type="email" inputmode="email" required />
        </div>
        <div class="field">
          <label for="occupation">{t.fields.occupation} *</label>
          <input id="occupation" name="Occupation" type="text" required />
        </div>
      </div>

      <div class="field">
        <label for="motivation">{t.fields.motivation} *</label>
        <textarea id="motivation" name="Motivation" required></textarea>
      </div>

      <label class="consent">
        <input type="checkbox" name="consent" required />
        <span>{t.fields.consent}</span>
      </label>

      <button
        class="btn btn--primary btn--lg"
        type="submit"
        data-submit
        disabled={!enabled}
      >
        {t.submit}
      </button>

      <p class="form-status" data-form-status role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style>
  .form-section {
    max-width: 48rem;
  }

  .form-section .card {
    padding: clamp(1.4rem, 4vw, 2.6rem);
  }

  .form-grid {
    display: grid;
    gap: 0 1.2rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .form-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  button[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }
</style>

<script>
  const form = document.querySelector("[data-membership-form]") as HTMLFormElement | null;
  if (form) {
    const status = form.querySelector("[data-form-status]") as HTMLParagraphElement | null;
    const submitBtn = form.querySelector("[data-submit]") as HTMLButtonElement | null;

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const bot = form.querySelector<HTMLInputElement>('input[name="botcheck"]');
      if (bot?.checked) return;
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      if (!submitBtn || !status) return;

      submitBtn.disabled = true;
      const originalLabel = submitBtn.textContent;
      const sending = form.dataset.sending ?? "";
      const success = form.dataset.success ?? "";
      const error = form.dataset.error ?? "";
      submitBtn.textContent = sending;

      try {
        const body = new FormData(form);
        const response = await fetch(form.action, {
          method: "POST",
          body,
          headers: { Accept: "application/json" },
        });
        const json = await response.json();
        if (!response.ok || !json.success) throw new Error("form-error");
        status.dataset.state = "success";
        status.textContent = success;
        form.reset();
      } catch {
        status.dataset.state = "error";
        status.textContent = error;
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalLabel;
      }
    });
  }
</script>