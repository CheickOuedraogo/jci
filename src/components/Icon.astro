---
interface Props {
  name: "growth" | "megaphone" | "shield-heart";
}

const { name = "growth" } = Astro.props;
---

{
  /* Axe 1 — montee.
     La mallette d'origine symbolisait l'employe, alors que l'axe parle
     justement de creer des cheffes d'entreprise. Une fleche ascendante
     seule remplace les barres : a 26px, trois barres de 3.5 avec un
     trait de 1.7 fusionnaient en un bloc plein. */
  name === "growth" && (
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3.5 20.6h6.5" />
      <path d="M4.5 17.6 17.2 4.9" />
      <path d="M10.4 4.9h6.8v6.8" />
    </svg>
  )
}
{
  /* Axe 2 — megaphone : prendre la parole.
     Le micro d'origine ne couvrait qu'un des quatre points de l'axe et
     se confondait avec lui. La megaphone dit "faire entendre sa voix",
     ce qui porte aussi le message "plus aucune femme ne s'excuse". */
  name === "megaphone" && (
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4.3 9.4v4.8a1.5 1.5 0 0 0 1.5 1.5h2.4l6.6 4.2V5.3L8.2 9.4H5.8a1.5 1.5 0 0 0-1.5 1.5Z" />
      <path d="M8.2 9.4v9.8" />
      <path d="M18.1 8.1a4.6 4.6 0 0 1 0 7.4" />
      <path d="M14.8 4.3a8.6 8.6 0 0 1 0 15" />
    </svg>
  )
}
{
  /* Axe 3 — coeur dans un bouclier.
     Le bouclier seul restait generique, et la version adulte+enfant
     fusionnait (l'arc de protection se confondait avec la tete). Deux
     formes concentriques ne peuvent pas se confondre. Coeur en contour
     pour ne pas resemble au coeur plein du bouton don. */
  name === "shield-heart" && (
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 2.5 19.4 5.4v5.7c0 4.6-3.1 8.4-7.4 10.5-4.3-2.1-7.4-5.9-7.4-10.5V5.4Z" />
      <path d="M12 15.74 7.61 11.42a2.45 2.45 0 0 1 3.67-3.09L12 9.12l.72-.79a2.45 2.45 0 0 1 3.67 3.09Z" />
    </svg>
  )
}
