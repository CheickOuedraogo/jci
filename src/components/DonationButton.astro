---
import { DONATION_URL } from "../lib/site.config";
import { COPY } from "../data/content";

const { lang = "fr", classes = "btn btn--accent btn--lg", label } = Astro.props;
const t = COPY[lang].contact;
const buttonLabel = label ?? t.donateButton;
const hasLink = typeof DONATION_URL === "string" && DONATION_URL.trim() !== "";
---

{
  /* Ce composant ne fait plus que le bouton. Le dialogue est unique et
     vit dans Base.astro : ici il etait imbrique dans le panneau du heros,
     dont le backdrop-filter transformait le panneau en bloc conteneur
     pour le position:fixed du modal, et dont color:white rendait le
     texte du modal blanc sur fond blanc. */
  hasLink ? (
    <a class={classes} href={DONATION_URL} target="_blank" rel="noopener">
      {buttonLabel}
    </a>
  ) : (
    <button class={classes} type="button" data-donate-trigger>
      {buttonLabel}
    </button>
  )
}
