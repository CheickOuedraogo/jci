---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, altPath, withBase } from "../lib/site.config";

interface Props {
  lang: "fr" | "en";
  current: string;
  title: string;
  description: string;
}

const { lang = "fr", current = "/", title, description } = Astro.props;
const canonical = `${SITE.url}${current}`;
const alternateUrl = `${SITE.url}${altPath(current, lang)}`;
const ogImage = `${SITE.url}${withBase("/logo.png")}`;
const menuLabel = lang === "fr" ? "Aller au contenu" : "Skip to content";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#081a44" />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === "fr" ? "en" : "fr"} href={alternateUrl} />
    <link rel="alternate" hreflang="x-default" href={SITE.url} />

    <link rel="icon" type="image/png" href={withBase("/favicon-32.png")} />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#contenu">{menuLabel}</a>
    <Header lang={lang} current={current} />
    <main id="contenu">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>