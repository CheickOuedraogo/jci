---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import DonationDialog from "../components/DonationDialog.astro";
import { SITE, altPath, withBase } from "../lib/site.config";

interface Props {
  lang: "fr" | "en";
  current: string;
  title: string;
  description: string;
}

const { lang = "fr", current = "/", title, description } = Astro.props;

const cleanPath = current === "/" ? "/" : current.endsWith("/") ? current : `${current}/`;
const canonical = `${SITE.url}${cleanPath}`;
const altCleanPath = altPath(current, lang);
const formattedAltPath = altCleanPath === "/" ? "/" : altCleanPath.endsWith("/") ? altCleanPath : `${altCleanPath}/`;
const alternateUrl = `${SITE.url}${formattedAltPath}`;
const ogImage = `${SITE.url}${withBase("/logo.png")}`;
const menuLabel = lang === "fr" ? "Aller au contenu" : "Skip to content";

const schemaOrg = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["NGO", "NonprofitOrganization"],
      "@id": `${SITE.url}/#organization`,
      name: SITE.name,
      alternateName: SITE.shortName,
      url: SITE.url,
      logo: {
        "@type": "ImageObject",
        "@id": `${SITE.url}/#logo`,
        url: ogImage,
        caption: SITE.name,
      },
      image: ogImage,
      description: lang === "fr" ? SITE.taglineFr : SITE.taglineEn,
      email: SITE.email,
      telephone: SITE.phoneDisplay,
      address: {
        "@type": "PostalAddress",
        addressLocality: "Ouagadougou",
        addressCountry: "BF",
      },
      sameAs: [
        "https://facebook.com",
        "https://tiktok.com",
        "https://linkedin.com",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${SITE.url}/#website`,
      url: `${SITE.url}/`,
      name: SITE.name,
      description: lang === "fr" ? SITE.taglineFr : SITE.taglineEn,
      publisher: {
        "@id": `${SITE.url}/#organization`,
      },
      inLanguage: lang === "fr" ? "fr-FR" : "en-US",
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: title,
      description: description,
      isPartOf: {
        "@id": `${SITE.url}/#website`,
      },
      inLanguage: lang === "fr" ? "fr-FR" : "en-US",
      breadcrumb: {
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: lang === "fr" ? "Accueil" : "Home",
            item: lang === "fr" ? `${SITE.url}/` : `${SITE.url}/en/`,
          },
          ...(current !== "/" && current !== "/en/"
            ? [
                {
                  "@type": "ListItem",
                  position: 2,
                  name: title.split("—")[0].split("|")[0].trim(),
                  item: canonical,
                },
              ]
            : []),
        ],
      },
    },
  ],
};
---

<!doctype html>
<html lang={lang} prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a1c3d" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content={SITE.name} />
    <meta name="publisher" content={SITE.name} />

    <!-- Géolocalisation pour le référencement local (Burkina Faso) -->
    <meta name="geo.region" content="BF-03" />
    <meta name="geo.placename" content="Ouagadougou, Burkina Faso" />
    <meta name="geo.position" content="12.3714;-1.5197" />
    <meta name="ICBM" content="12.3714, -1.5197" />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === "fr" ? "fr" : "en"} href={canonical} />
    <link rel="alternate" hreflang={lang === "fr" ? "en" : "fr"} href={alternateUrl} />
    <link rel="alternate" hreflang="x-default" href={`${SITE.url}/`} />

    <link rel="icon" type="image/png" sizes="32x32" href={withBase("/favicon-32.png")} />
    <link rel="icon" type="image/png" sizes="512x512" href={withBase("/icon-512.png")} />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
    <link rel="manifest" href={withBase("/site.webmanifest")} />
    <meta name="msapplication-config" content={withBase("/browserconfig.xml")} />
    <meta name="msapplication-TileColor" content="#0a1c3d" />

    <!-- Open Graph (Facebook, WhatsApp, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "fr" ? "en_US" : "fr_FR"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="640" />
    <meta property="og:image:height" content="435" />
    <meta property="og:image:alt" content={SITE.name} />

    <!-- Twitter Card (X) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={SITE.name} />

    <!-- Données structurées JSON-LD (Schema.org) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,400..800;1,400..600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#contenu">{menuLabel}</a>
    <Header lang={lang} current={current} />
    <main id="contenu">
      <slot />
    </main>
    <Footer lang={lang} />
    {/* Dons désactivés temporairement :
    <DonationDialog lang={lang} />
    */}
  </body>
</html>