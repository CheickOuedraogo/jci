---
import Base from "../../layouts/Base.astro";
import AxesGrid from "../../components/AxesGrid.astro";
import { COPY } from "../../data/content";
import { withBase } from "../../lib/site.config";

const lang = "en";
const t = COPY[lang];
const current = "/en/programs";
---

<Base
  lang={lang}
  current={current}
  title={t.seo.axes.title}
  description={t.seo.axes.description}
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">{t.axes.eyebrow}</p>
      <h1>{t.axes.title}</h1>
      <p class="lead">{t.axes.intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <AxesGrid lang={lang} />
    </div>
  </section>

  <section class="section section--navy">
    <div class="container center">
      <p class="eyebrow eyebrow--light">{t.axes.ctaEyebrow}</p>
      <h2>{t.axes.ctaTitle}</h2>
      <p style="max-width: 32em; margin: 0 auto 2rem;">{t.axes.ctaBody}</p>
      <a class="btn btn--accent btn--lg" href={withBase("/en/join")}>
        {t.axes.ctaButton}
      </a>
    </div>
  </section>
</Base>